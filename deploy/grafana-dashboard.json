{
  "title": "RRouter",
  "uid": "rrouter-overview",
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["rrouter", "llm-gateway"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by status",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(rrouter_requests_total[5m]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Upstream fallbacks per second",
      "description": "attempts minus requests: a positive value means an account failed and another was tried",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 20, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(rrouter_attempts_total[5m])) - sum(rate(rrouter_requests_total[5m]))",
          "legendFormat": "fallback attempts"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency (p50 / p95 / p99)",
      "gridPos": { "x": 0, "y": 8, "w": 16, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(rrouter_request_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(rrouter_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(rrouter_request_duration_seconds_bucket[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Accounts fenced by the breaker",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [{ "refId": "A", "expr": "sum(rrouter_breaker_open)" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errors by provider",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, status) (rate(rrouter_requests_total{status=~\"4..|5..\"}[5m]))",
          "legendFormat": "{{provider}} {{status}}"
        }
      ]
    }
  ]
}
