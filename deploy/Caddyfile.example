# Reverse proxy in front of RRouter.
#
#   your-gateway.example.com {
#       reverse_proxy 127.0.0.1:20128
#   }
#
# RRouter must see a non-loopback socket address for this to matter: with the default
# RROUTER_HOST=127.0.0.1 the proxy talks to loopback, so the admin gate stays in loopback
# mode and the remote caller cannot reach /api at all. If you bind a public address,
# set RROUTER_ALLOW_REMOTE_ADMIN=true and put authentication in this proxy - the admin
# API has no built-in user login.

your-gateway.example.com {
    encode zstd gzip

    # Streaming: do not buffer SSE or cap the response.
    reverse_proxy 127.0.0.1:20128 {
        flush_interval -1
        transport http {
            read_timeout 15m
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
