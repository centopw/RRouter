# Reverse proxy in front of RRouter.
#
# RRouter must be bound to loopback (its default). This proxy then talks to it from
# loopback, so the *admin* API (/api, /metrics) is reachable through the proxy even
# though RRouter otherwise restricts it to local callers. Protect those paths here:
# the admin API has no built-in user login.

your-gateway.example.com {
    encode zstd gzip

    # Generate the hash with: caddy hash-password --plaintext 'choose-a-password'
    @admin path /api/* /metrics
    basic_auth @admin {
        admin $2a$14$REPLACE_WITH_A_BCRYPT_HASH
    }

    # Streaming: do not buffer SSE or cap the response.
    reverse_proxy 127.0.0.1:20128 {
        flush_interval -1
        transport http {
            read_timeout 15m
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
