# Copy to .env and pass with `docker compose --env-file .env up -d`, or export these
# before running the binary. Every setting is optional.

# Bind address and port.
# RROUTER_HOST=127.0.0.1
# RROUTER_PORT=20128

# SQLite database, master key file, and /ext assets.
# RROUTER_DATA_DIR=./data

# 64 hex characters; otherwise generated into <data dir>/master.key (0600).
# RROUTER_MASTER_KEY=

# Require sk-rr-... on /v1/*. Recommended for anything beyond a trusted network.
# RROUTER_REQUIRE_API_KEY=false

# Serve the admin API beyond loopback. Required when RROUTER_HOST is not loopback.
# RROUTER_ALLOW_REMOTE_ADMIN=false

# Comma-separated allowlist; "*" is rejected at startup.
# RROUTER_CORS_ORIGINS=

# Upstream timeouts.
# RROUTER_REQUEST_TIMEOUT_SECS=600
# RROUTER_CONNECT_TIMEOUT_SECS=15

# Admin API (/api/* and /metrics). When set, every admin request must present this
# token as `Authorization: Bearer <token>` or `x-admin-token: <token>`; the loopback
# rule no longer applies. Required behind a reverse proxy or on a shared host.
# RROUTER_ADMIN_TOKEN=

# Concurrent /v1/* requests, streamed bodies included. 0 = unlimited.
# Beyond the cap a request is refused with 503 `overloaded` + Retry-After: 1.
# RROUTER_MAX_CONCURRENCY=0

# Upstream sends per request (provider fallbacks), clamped to 1..8.
# RROUTER_MAX_ATTEMPTS=4

# Seconds graceful shutdown may drain live streams; 0 = wait indefinitely.
# RROUTER_SHUTDOWN_GRACE_SECS=20

# Exact-match response cache for non-streaming /v1/chat/completions, /v1/messages and
# /v1/responses. off (default) or sqlite (stored in the gateway database). A client
# sends `x-rrouter-cache: bypass` to skip both the read and the write.
# RROUTER_CACHE=off

# Seconds a cached response stays servable, clamped to 1..86400.
# RROUTER_CACHE_TTL_SECS=300

# Cached responses kept, clamped to 1..100000. Oldest created_at is evicted first.
# RROUTER_CACHE_MAX_ENTRIES=1000

# Days of usage and attempt history kept in the database, clamped to 0..3650.
# 0 (default) keeps everything. Expired cache rows are swept daily either way, and a
# sweep runs `PRAGMA optimize` to keep query plans sane as history is deleted.
# RROUTER_USAGE_RETENTION_DAYS=0

# Log filter (tracing).
# RUST_LOG=rrouter=info

# Log line shape: text (default, for a terminal) or json (one object per line, for
# Loki/CloudWatch). Any other value stops startup.
# RROUTER_LOG_FORMAT=text

# One `request` info line per finished request (request_id, provider, model, status,
# latency_ms, ttft_ms, key_id, endpoint). false silences only that line.
# RROUTER_ACCESS_LOG=true
